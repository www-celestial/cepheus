(** Files through a real server, as a program keeps them: a file kind, Put, Read whole and by ranges, List, Get,
    Delete, Erase; a token per kind that may not read the kind of files; every result printed, for test/cesia.sh.

    CEPHEUS_URL=... CEPHEUS_TOKEN=... CEPHEUS_OTHER=... cesia run --allow native=cepheus,env,read src/files.ce *)
use deps/www-celestial/cepheus/cesia/cepheus
use std/io
use std/result
use std/sys
use std/text
use std/value

Person = cepheus.Kind("person", {Name: cepheus.Text()})
Scans = cepheus.Files("scan")
db = result.Unwrap(cepheus.Connect(sys.Env("CEPHEUS_URL"), [Person, Scans], token = sys.Env("CEPHEUS_TOKEN")))
ada = result.Unwrap(cepheus.Insert(Person, {Name: "Ada"}, db))
body = text.Repeat(400_000, "0123456789")
bin = text.Join("", [text.FromBytes([b for b in 0..255]), text.Repeat(1000, text.FromBytes([0, 255, 128]))])
f = result.Unwrap(cepheus.Put(Scans, "log.txt", body, db, type = "text/plain", owner = ada))
g = result.Unwrap(cepheus.Put(Scans, "blob.bin", bin, db, cold = true))
io.Print("files: read whole:", result.Unwrap(cepheus.Read(Scans, f, db)) == body, result.Unwrap(cepheus.Read(Scans, g, db)) == bin)
io.Print("files: a range:", result.Unwrap(cepheus.Read(Scans, f, db, from = 1_000_005, len = 7)))
io.Print("files: the end:", value.Len(result.Unwrap(cepheus.Read(Scans, f, db, from = 3_999_990))))
io.Print("files: past the end:", cepheus.Read(Scans, f, db, from = 3_999_999, len = 2).Error.Code)
meta = result.Unwrap(cepheus.Get(Scans, f, db))
io.Print("files: get:", meta.Name, meta.Size, meta.Type, meta.Owner == ada, text.ByteLength(meta.Content))
io.Print("files: list:", value.Len(result.Unwrap(cepheus.List(Scans, db))))
io.Print("files: no owner, no erasure:", cepheus.Erase(0, db).Error.Code)
io.Print("files: a fork holds none:", cepheus.Put(Scans, "x", "x", result.Unwrap(cepheus.Fork(cepheus.Empty, [Scans]))).Error.Code)
other = result.Unwrap(cepheus.Connect(sys.Env("CEPHEUS_URL"), [], token = sys.Env("CEPHEUS_OTHER")))
io.Print("files: another kind's token reads:", cepheus.Read(Scans, f, other).Error.Code)
result.Unwrap(cepheus.Delete(Scans, g, db))
io.Print("files: deleted, list:", value.Len(result.Unwrap(cepheus.List(Scans, db))))
result.Unwrap(cepheus.Erase(ada, db))
io.Print("files: erased owner:", cepheus.Read(Scans, f, db, len = 1).Error.Code, cepheus.Put(Scans, "y", "y", db, owner = ada).Error.Code)
