(* Invoices: made with their lines in one group, changed while they are not paid, paid once, deleted while not paid,
   found, listed by pages with filters, and marked late. Each function takes the database last. *)
use deps/www-celestial/cepheus/cesia/cepheus
use std/dict
use std/list
use std/result
use std/value

InvoiceSorts = ["-number", "number", "-date", "due", "-total"]   (** The orders of the list of invoices; - is the largest first. *)
Statuses = ["unpaid", "late", "paid"]   (** The statuses of an invoice. *)
Week = 604800   (** Seconds in a week. *)

defn largestNumber(db)
  (** The largest invoice number, 0 when there is none: read in the index's order, one row. *)
  top = cepheus.Find(2, (i, n) -> {Where: [[i, Invoice.Number, n]], Give: {N: n}, Sort: [cepheus.Desc(n)], Limit: 1}, db)?
  result.Ok(if value.Len(top) == 0 0 else top[1].N end)
end

defn invoiceCounter(db)
  (** The counter that numbers the invoices: an Ok of its id. Made at the first invoice, from the largest number the
      database holds, so that a database filled before it goes on from there; two programs that make it at once get
      the same one, its name being unique. *)
  for attempt in 1..2
    found = cepheus.Find(1, (c) -> {Where: [[c, Counter.Name, "invoice"]], Give: {C: c}}, db)?
    if value.Len(found) > 0
      return result.Ok(found[1].C)
    end
    made = cepheus.Insert(Counter, {Name: "invoice", Last: largestNumber(db)?}, db, why = "invoice counter made")
    if result.IsOk(made) or made.Error.Code != "unique"
      return made
    end
  end
  result.Err({Code: "busy", Message: "The counter of the invoices is being made: try again."})
end

defn CatchUpNumbers(db)
  (** Moves the counter of the invoices up to the largest number the database holds, after a program numbered
      invoices without it (the seed does): the next invoice takes the number after. An Ok of the counter's id. *)
  c = invoiceCounter(db)?
  last = cepheus.Get(Counter, c, db)?.Last
  top = largestNumber(db)?
  if value.IsMissing(last) or top > last
    (* as it was read: an invoice numbered meanwhile moved the counter, and the group is refused *)
    moved = cepheus.Write([cepheus.Expect(c, Counter.Last, last), cepheus.Add(c, Counter.Last, top)], db, why = "invoice numbers caught up")
    if result.IsErr(moved) and moved.Error.Code != "conflict"
      return moved
    end
  end
  result.Ok(c)
end

defn lineOps(inv, lines, from)
  (** The facts of an invoice's lines, each a new thing of the group from New(from). *)
  ops = []
  k = 0
  for l in lines
    k += 1
    t = cepheus.New(from + k - 1)
    ops = list.Concat(ops, [cepheus.Add(t, Line.Invoice, inv), cepheus.Add(t, Line.Position, k), cepheus.Add(t, Line.Label, l.Label),
                            cepheus.Add(t, Line.Quantity, l.Quantity), cepheus.Add(t, Line.Price, l.Price)])
  end
  ops
end

defn AddInvoice(f, billTo, by, db)
  (** A new unpaid invoice with its lines, in one group: f as InvoiceForm checked it, billTo the client's name now. Its
      number is the counter's next, which the database takes in the same group (cepheus.Incr): the numbers follow
      each other without a gap, as the law of many countries asks, and invoices made at once neither wait for each
      other nor retry. An Ok of {Invoice}. *)
  c = invoiceCounter(db)?
  inv = cepheus.New(1)
  ops = list.Concat([cepheus.Incr(c, Counter.Last, into = [inv, Invoice.Number]), cepheus.Add(inv, Invoice.Client, f.Client), cepheus.Add(inv, Invoice.BillTo, billTo),
                     cepheus.Add(inv, Invoice.Search, Lower(billTo)), cepheus.Add(inv, Invoice.Date, f.Date), cepheus.Add(inv, Invoice.Due, f.Due),
                     cepheus.Add(inv, Invoice.Status, "unpaid"), cepheus.Add(inv, Invoice.Total, f.Total)], lineOps(inv, f.Lines, 2))
  done = cepheus.Write(ops, db, by = by, why = "invoice added")
  if result.IsErr(done) and done.Error.Code == "unique"
    (* a number taken without the counter (by the seed, or by hand): the counter catches up, and one more try *)
    CatchUpNumbers(db)?
    done = cepheus.Write(ops, db, by = by, why = "invoice added")
  end
  result.Ok({Invoice: done?.Things[1]})
end

defn GetInvoice(id, db)
  (** An invoice with its lines, in their order: an Ok of its fields and Lines, or of missing. *)
  inv = cepheus.Get(Invoice, id, db)?
  if value.IsMissing(inv) or value.IsMissing(inv.Number)
    return result.Ok(missing)
  end
  lines = cepheus.Find(5, (l, p, a, q, c) -> {
    Where: [[l, Line.Invoice, id], [l, Line.Position, p], [l, Line.Label, a], [l, Line.Quantity, q], [l, Line.Price, c]],
    Give: {Line: l, Position: p, Label: a, Quantity: q, Price: c},
    Sort: [p],
  }, db)?
  inv.Id = id
  inv.Lines = lines
  result.Ok(inv)
end

defn linesGone(inv)
  (** The facts of an invoice's lines, retracted. *)
  ops = []
  for l in inv.Lines
    ops = list.Concat(ops, [cepheus.Retract(l.Line, Line.Invoice, inv.Id), cepheus.Retract(l.Line, Line.Position, l.Position), cepheus.Retract(l.Line, Line.Label, l.Label),
                            cepheus.Retract(l.Line, Line.Quantity, l.Quantity), cepheus.Retract(l.Line, Line.Price, l.Price)])
  end
  ops
end

defn EditInvoice(id, f, now, by, db)
  (** New dates and lines for an invoice that is not paid, as it was read (a payment meanwhile refuses the group): its
      lines are replaced, its total computed again, and a late invoice due again later is unpaid again. *)
  inv = GetInvoice(id, db)?
  if value.IsMissing(inv)
    return result.Err({Code: "missing", Message: "There is no invoice $id."})
  end
  if inv.Status == "paid"
    return result.Err({Code: "paid", Message: "Invoice $(inv.Number) is paid: it stays as it is."})
  end
  status = if f.Due < now and inv.Status == "late" "late" else "unpaid" end
  ops = list.Concat([cepheus.Expect(id, Invoice.Status, inv.Status), cepheus.Add(id, Invoice.Date, f.Date), cepheus.Add(id, Invoice.Due, f.Due),
                     cepheus.Add(id, Invoice.Total, f.Total), cepheus.Add(id, Invoice.Status, status)], list.Concat(linesGone(inv), lineOps(id, f.Lines, 1)))
  cepheus.Write(ops, db, by = by, why = "invoice changed")
end

defn PayInvoice(id, now, by, db)
  (** Marks an invoice paid at now, once: an Ok of the group's number, or an Err, Code "paid" when it is paid already
      (by this request or another one). *)
  inv = cepheus.Get(Invoice, id, db)?
  if value.IsMissing(inv) or value.IsMissing(inv.Status)
    return result.Err({Code: "missing", Message: "There is no invoice $id."})
  end
  if inv.Status == "paid"
    return result.Err({Code: "paid", Message: "Invoice $(inv.Number) is paid already."})
  end
  done = cepheus.Write([cepheus.Expect(id, Invoice.Status, inv.Status), cepheus.Add(id, Invoice.Status, "paid"), cepheus.Add(id, Invoice.PaidAt, now)], db, by = by, why = "invoice paid")
  if result.IsErr(done) and done.Error.Code == "conflict"
    return PayInvoice(id, now, by, db)
  end
  result.Ok(done?.Group)
end

defn DeleteInvoice(id, by, db)
  (** Deletes an invoice that is not paid, with its lines, as it was read. *)
  inv = GetInvoice(id, db)?
  if value.IsMissing(inv)
    return result.Err({Code: "missing", Message: "There is no invoice $id."})
  end
  if inv.Status == "paid"
    return result.Err({Code: "paid", Message: "Invoice $(inv.Number) is paid: it stays."})
  end
  ops = [cepheus.Expect(id, Invoice.Status, inv.Status)]
  for f in [{P: Invoice.Number, V: inv.Number}, {P: Invoice.Client, V: inv.Client}, {P: Invoice.BillTo, V: inv.BillTo}, {P: Invoice.Search, V: inv.Search},
            {P: Invoice.Date, V: inv.Date}, {P: Invoice.Due, V: inv.Due}, {P: Invoice.Status, V: inv.Status}, {P: Invoice.Total, V: inv.Total}]
    if not value.IsMissing(f.V)
      ops = list.Append(cepheus.Retract(id, f.P, f.V), ops)
    end
  end
  cepheus.Write(list.Concat(ops, linesGone(inv)), db, by = by, why = "invoice deleted")?
  result.Ok(missing)
end

defn filterOf(f, i, s, u, now)
  (** The conditions of a filter on an invoice i, its status s and its due date u: f.Statuses, one or two of
      "unpaid", "late" and "paid" (In); f.Action, late or due within a week (Or); f.Open, not paid (Not). *)
  out = []
  n = value.Len(f.Statuses)
  if n > 0 and n < 3
    out = list.Append(cepheus.In(s, f.Statuses), out)
  end
  if f.Action
    out = list.Append(cepheus.Or([i, Invoice.Status, "late"], cepheus.And([i, Invoice.Status, "unpaid"], cepheus.Below(u, now + Week))), out)
  end
  if f.Open
    out = list.Append(cepheus.Not([i, Invoice.Status, "paid"]), out)
  end
  out
end

defn sortKeys(sort, i, no, d, u, t)
  (** The keys of Sort for one of InvoiceSorts: its key, then the due date and the invoice, so that the invoice decides
      a tie (as the pages ordered their rows when they read their keys first: a link saved then names the same rows). *)
  match sort
    "number" -> [no, u, i]
    "-date" -> [cepheus.Desc(d), u, i]
    "due" -> [u, i]
    "-total" -> [cepheus.Desc(t), u, i]
    else -> [cepheus.Desc(no), u, i]
  end
end

defn invoicesWhere(f, now, i, no, b, d, u, s, t)
  (** The patterns and conditions of the list of invoices, without its search. *)
  list.Concat([[i, Invoice.Number, no], [i, Invoice.BillTo, b], [i, Invoice.Date, d], [i, Invoice.Due, u], [i, Invoice.Status, s], [i, Invoice.Total, t]],
              list.Concat(filterOf(f, i, s, u, now), if value.IsMissing(f.Client) [] else [[i, Invoice.Client, f.Client]] end))
end

defn invoicesQuery(f, now)
  (** The question of the list of invoices, for Page: f as InvoicesPage takes it. A search needs a variable more, the
      bill-to name in lower case: the question has 8 variables then, else 7, since every variable of a question must
      be in a pattern. An Ok of {N, Query}. *)
  give(i, no, b, d, u, s, t) = {Invoice: i, Number: no, BillTo: b, Date: d, Due: u, Status: s, Total: t}
  if f.Search == ""
    return {N: 7, Query: (p) -> ((i, no, b, d, u, s, t) -> {Where: invoicesWhere(f, now, i, no, b, d, u, s, t), Give: give(i, no, b, d, u, s, t),
                                                              Sort: p.Sort(sortKeys(f.Sort, i, no, d, u, t)), Limit: p.Limit, After: p.After})}
  end
  {N: 8, Query: (p) -> ((i, no, b, d, u, s, t, k) -> {Where: list.Concat(invoicesWhere(f, now, i, no, b, d, u, s, t), [[i, Invoice.Search, k], cepheus.Prefix(k, f.Search)]),
                                                        Give: give(i, no, b, d, u, s, t), Sort: p.Sort(sortKeys(f.Sort, i, no, d, u, t)), Limit: p.Limit, After: p.After})}
end

defn pageCursor(cursor, f, db)
  (** The cursor of a page of invoices, a row of its seven fields. One saved in a link before a page was one question
      is a row of its keys, {Invoice, Number, Status, Due, X}, X the total when the order is by total, else the date:
      it is made the row it stands for, its other fields read from its invoice, so that the link gives the rows after
      that invoice (or before it), as it did. A deleted invoice's other fields are left empty: the keys of the order,
      its id among them, place it before they are read. A cursor that is neither is left to Find, which refuses it. *)
  if not value.IsDict(cursor)
    return result.Ok(cursor)
  end
  back = "Before" in cursor
  row = if back cursor.Before else cursor.After end
  if not (value.IsDict(row) and "X" in row and value.IsInt(dict.Get("Invoice", row)))
    return result.Ok(cursor)
  end
  inv = cepheus.Get(Invoice, row.Invoice, db)?
  have(x, field) = if value.IsMissing(inv) x else dict.GetOr(field, x, inv) end
  byTotal = f.Sort == "-total"
  full = {Invoice: row.Invoice, Number: dict.Get("Number", row), BillTo: have("", "BillTo"), Date: if byTotal have(0, "Date") else row.X end,
          Due: dict.Get("Due", row), Status: dict.Get("Status", row), Total: if byTotal row.X else have(0, "Total") end}
  result.Ok(if back {Before: full} else {After: full} end)
end

defn InvoicesPage(f, now, cursor, size, db)
  (** A page of invoices, as Page gives it, with every field of each row: f is {Statuses, Action, Open, Search,
      Client, Sort}, as filterOf reads the first three; Search a start of the bill-to name in lower case ("" for all),
      Client an id or missing, Sort one of InvoiceSorts. One sorted question of seven patterns (eight with a search):
      the page's cursors are its rows (pageCursor reads the older ones too). *)
  q = invoicesQuery(f, now)
  Page(q.N, q.Query, db, size, cursor = pageCursor(cursor, f, db)?)
end

defn AllInvoices(f, now, db)
  (** Every invoice of the list's filter f, in the order of their numbers, with PaidAt for those paid: one question
      for the rows, and one for the dates of payment of each 10,000 of them (an In of 10,000 ids a question). *)
  q = invoicesQuery(f, now)
  rows = cepheus.Find(q.N, q.Query({Sort: (keys) -> keys, Limit: missing, After: missing}), db)?
  at = dict.Dict()
  ids = [r.Invoice for r in rows]
  from = 1
  while from <= value.Len(ids)
    part = list.Take(10000, list.Skip(from - 1, ids))
    for x in cepheus.Find(2, (i, p) -> {Where: [[i, Invoice.PaidAt, p], cepheus.In(i, part)], Give: {Invoice: i, PaidAt: p}}, db)?
      at[x.Invoice] = x.PaidAt
    end
    from += 10000
  end
  result.Ok([{Invoice: r.Invoice, Number: r.Number, BillTo: r.BillTo, Date: r.Date, Due: r.Due, Status: r.Status, Total: r.Total, PaidAt: dict.Get(r.Invoice, at)} for r in rows])
end

defn MarkLate(now, db, most = 500)
  (** Marks late the unpaid invoices whose due date has passed, at most most of them, in one group, each as it was read
      (one paid meanwhile is left for the next round): an Ok of how many. *)
  due = cepheus.Find(2, (i, u) -> {Where: [[i, Invoice.Status, "unpaid"], [i, Invoice.Due, u], cepheus.Below(u, now)], Give: {Invoice: i, Due: u}, Sort: [u], Limit: most}, db)?
  if value.Len(due) == 0
    return result.Ok(0)
  end
  ops = []
  for r in due
    ops = list.Concat([cepheus.Expect(r.Invoice, Invoice.Status, "unpaid"), cepheus.Add(r.Invoice, Invoice.Status, "late")], ops)
  end
  done = cepheus.Write(ops, db, why = "invoices late")
  if result.IsErr(done) and done.Error.Code == "conflict"
    return result.Ok(0)
  end
  done?
  result.Ok(value.Len(due))
end

defn BillTo(client, db)
  (** The name to bill a client to: its name, or for a token that may not read clients (the accountant's), the bill-to
      name of its latest invoice. An Ok of it, or of missing for a client the database doesn't know. *)
  c = GetClient(client, db)
  if result.IsOk(c) and not value.IsMissing(c.Value)
    return result.Ok(c.Value.Name)
  end
  last = cepheus.Find(3, (i, no, b) -> {Where: [[i, Invoice.Client, client], [i, Invoice.Number, no], [i, Invoice.BillTo, b]], Give: {Number: no, BillTo: b}, Sort: [cepheus.Desc(no)], Limit: 1}, db)?
  result.Ok(if value.Len(last) == 0 missing else last[1].BillTo end)
end
