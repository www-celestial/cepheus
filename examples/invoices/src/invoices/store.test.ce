(* The checks, the clients and the invoices on forks of Empty: no server. *)
use deps/www-celestial/cepheus/cesia/cepheus
use std/bug
use std/dict
use std/encode
use std/fiber
use std/list
use std/result
use std/text
use std/value

now = 1794528000   (* 2026-11-13 00:00 UTC *)
day = 86400

defn shop()
  (** A fork with the app's kinds and rules, two clients, and three invoices of Ada. *)
  t = cepheus.Fork(cepheus.Empty, Kinds)?
  cepheus.Define(Rules, t)?
  ada = AddClient(ClientForm({name: "Ada Martin", email: "Ada@Example.com", city: "Lyon"})?, 0, t)?
  bo = AddClient(ClientForm({name: "Élodie Bo", email: "bo@example.com", city: "Paris"})?, 0, t)?
  form = {client: "$ada", date: "2026-10-01", due: "2026-10-31", label1: "Design", quantity1: "3", price1: "400", label2: "Hosting", quantity2: "1", price2: "80.50"}
  one = AddInvoice(InvoiceForm(form)?, "Ada Martin", 0, t)?
  form.due = "2026-12-01"
  two = AddInvoice(InvoiceForm(form)?, "Ada Martin", 0, t)?
  three = AddInvoice(InvoiceForm(form)?, "Ada Martin", 0, t)?
  result.Ok({Db: t, Ada: ada, Bo: bo, One: one, Two: two, Three: three})
end

all = {Statuses: [], Action: false, Open: false, Search: "", Client: missing, Sort: "-number"}

defn isClientChecked()
  bad = ClientForm({name: "", email: "nobody", city: text3()})
  ok = ClientForm({name: " Ada ", email: " ADA@Example.COM ", city: "Lyon"})?
  bug.Assert(value.Equal(list.Sort(dict.Keys(bad.Error)), ["City", "Email", "Name"]), "three wrong fields")
  ok.Name == "Ada" and ok.Email == "ada@example.com" and ok.Search == "ada"
end

text3() = text.Repeat(81, "a")

defn isLowerOfLatin()
  Lower("ÉLODIE Ñ Ü×") == "élodie ñ ü×"
end

defn isInvoiceChecked()
  bad = InvoiceForm({client: "x", date: "2026-13-01", due: "", label1: "A", quantity1: "0", price1: "1"})
  cents = InvoiceForm({client: "7", date: "2026-11-01", due: "2026-11-01", label1: "A", quantity1: "2", price1: "0.1", label3: "B", quantity3: "1", price3: "0.2"})?
  three = InvoiceForm({client: "7", date: "2026-11-01", due: "2026-11-01", label1: "A", quantity1: "1", price1: "1.005"})
  bug.Assert(value.Equal(list.Sort(dict.Keys(bad.Error)), ["Client", "Date", "Due", "Line1"]), "four wrong fields")
  bug.Assert(three.Error.Line1 != missing, "a third decimal is refused")
  cents.Total == 0.4 and value.Len(cents.Lines) == 2
end

defn isInvoiceMadeWithItsLines()
  s = shop()?
  inv = GetInvoice(s.One.Invoice, s.Db)?
  bug.Assert(inv.Number == 1 and cepheus.Get(Invoice, s.Two.Invoice, s.Db)?.Number == 2, "numbers follow")
  inv.Total == 1280.5 and inv.Status == "unpaid" and value.Len(inv.Lines) == 2 and inv.Lines[2].Label == "Hosting"
end

defn isPaidOnce()
  s = shop()?
  PayInvoice(s.One.Invoice, now, 0, s.Db)?
  again = PayInvoice(s.One.Invoice, now, 0, s.Db)
  inv = GetInvoice(s.One.Invoice, s.Db)?
  again.Error.Code == "paid" and inv.Status == "paid" and inv.PaidAt == now
end

defn isLateAndOverdue()
  s = shop()?
  n = MarkLate(now, s.Db)?
  late = GetInvoice(s.One.Invoice, s.Db)?.Status
  overdue = GetClient(s.Ada, s.Db)?.Overdue
  PayInvoice(s.One.Invoice, now, 0, s.Db)?
  n == 1 and late == "late" and overdue == true and GetClient(s.Ada, s.Db)?.Overdue == missing and MarkLate(now, s.Db)? == 0
end

defn isEditedWhileNotPaid()
  s = shop()?
  f = InvoiceForm({client: "$(s.Ada)", date: "2026-10-02", due: "2026-12-02", label1: "Audit", quantity1: "2", price1: "99.99"})?
  EditInvoice(s.Two.Invoice, f, now, 0, s.Db)?
  inv = GetInvoice(s.Two.Invoice, s.Db)?
  PayInvoice(s.Two.Invoice, now, 0, s.Db)?
  inv.Total == 199.98 and value.Len(inv.Lines) == 1 and EditInvoice(s.Two.Invoice, f, now, 0, s.Db).Error.Code == "paid"
end

defn isDeleteChecked()
  s = shop()?
  kept = DeleteClient(s.Ada, 0, s.Db)
  DeleteClient(s.Bo, 0, s.Db)?
  gone = GetClient(s.Bo, s.Db)?
  f = InvoiceForm({client: "$(s.Bo)", date: "2026-10-02", due: "2026-12-02", label1: "Audit", quantity1: "2", price1: "1"})?
  refused = AddInvoice(f, "Élodie Bo", 0, s.Db)
  bug.Assert(kept.Error.Code == "has_invoices", "a client with invoices stays")
  bug.Assert(refused.Error.Code == "invalid", "the rule refuses an invoice of a deleted client")
  raced = cepheus.Write([cepheus.Retract(s.Ada, Client.Name, "Ada Martin")], s.Db)
  bug.Assert(raced.Error.Code == "invalid", "the rule refuses a delete that comes after an invoice, as a race would")
  PayInvoice(s.One.Invoice, now, 0, s.Db)?
  DeleteInvoice(s.Two.Invoice, 0, s.Db)?
  value.IsMissing(gone) and DeleteInvoice(s.One.Invoice, 0, s.Db).Error.Code == "paid" and GetInvoice(s.Two.Invoice, s.Db)? == missing
end

defn isEmailUnique()
  s = shop()?
  AddClient(ClientForm({name: "Other", email: "ada@example.com", city: ""})?, 0, s.Db).Error.Code == "unique"
end

defn isClientsByPagesAndSearch()
  t = cepheus.Fork(cepheus.Empty, Kinds)?
  for k in 1..25
    AddClient({Name: "Client $(100 + k)", Search: "client $(100 + k)", Email: "c$k@example.com", City: "Lyon"}, 0, t)?
  end
  one = ClientsPage("", "name", missing, 10, t)?
  two = ClientsPage("", "name", one.Next, 10, t)?
  three = ClientsPage("", "name", two.Next, 10, t)?
  back = ClientsPage("", "name", three.Prev, 10, t)?
  found = ClientsPage("client 11", "name", missing, 10, t)?
  mail = ClientsPage("c2", "name", missing, 10, t)?
  bug.Assert(one.Prev == missing and one.Rows[1].Name == "Client 101", "the first page")
  bug.Assert(value.Len(three.Rows) == 5 and three.Next == missing, "the last page")
  bug.Assert(value.Equal(back.Rows, two.Rows) and back.Prev != missing, "the page before is the one before")
  bug.Assert(value.Len(found.Rows) == 10 and found.Rows[1].Name == "Client 110", "by the start of the name")
  value.Len(mail.Rows) == 7 and two.Rows[1].Name == "Client 111"
end

defn isInvoicesFiltered()
  s = shop()?
  MarkLate(now, s.Db)?
  PayInvoice(s.Three.Invoice, now, 0, s.Db)?
  page(f) = [r.Number for r in InvoicesPage(f, now, missing, 10, s.Db)?.Rows]
  f = all
  f.Statuses = ["late", "unpaid"]
  open = page(f)
  f.Statuses = []
  f.Open = true
  bug.Assert(value.Equal(open, [2, 1]) and value.Equal(page(f), [2, 1]), "In and Not")
  f.Open = false
  f.Action = true
  soon = page(f)
  f.Action = false
  f.Search = "ada m"
  f.Sort = "number"
  value.Equal(soon, [1]) and value.Equal(page(f), [1, 2, 3])
end

defn isBalanceNotPaid()
  s = shop()?
  PayInvoice(s.One.Invoice, now, 0, s.Db)?
  b = Balance(s.Ada, s.Db)?
  b.Total == 2561.0 and b.Count == 2 and InvoicesOf(s.Ada, s.Db)? == 3
end

defn isBillToForTheBooks()
  s = shop()?
  BillTo(s.Ada, s.Db)? == "Ada Martin" and BillTo(999, s.Db)? == missing
end

defn isCursorChecked()
  c = {After: {Client: 65536, Name: "Ada", Email: "a@x.fr", City: "Lyon"}}
  back = Cursor({after: text.Split("=", Link(c))[2] then encode.UrlDecode})
  value.Equal(back, c) and Cursor({after: "!!"}) == missing and Cursor({before: "e30"}) != missing
end

defn oldOrder(f, db)
  (** The invoices in the order the pages had when they read a page of their keys first (Invoice, Number, Status, Due,
      and X, the total when sorted by total, else the date; ties by those fields' names): their ids. *)
  x = if f.Sort == "-total" Invoice.Total else Invoice.Date end
  key(no, u, v) = match f.Sort
    "number" -> [no]
    "-date" -> [cepheus.Desc(v)]
    "due" -> [u]
    "-total" -> [cepheus.Desc(v)]
    else -> [cepheus.Desc(no)]
  end
  rows = cepheus.Find(5, (i, no, s, u, v) -> {Where: [[i, Invoice.Number, no], [i, Invoice.Status, s], [i, Invoice.Due, u], [i, x, v]],
                                             Give: {Invoice: i, Number: no, Status: s, Due: u, X: v}, Sort: key(no, u, v)}, db)?
  result.Ok([r.Invoice for r in rows])
end

defn isPageCursorNewOrOld()
  (** A page of invoices is one question, its cursor a row of its seven fields, in the order the pages had; a link
      saved with a cursor of the keys the pages read before gives the same pages, after and before it, through its
      link too; and one of an invoice deleted since gives the rows after its place. *)
  s = shop()?
  form = {client: "$(s.Bo)", date: "2026-10-02", due: "2026-10-31", label1: "Box", quantity1: "1", price1: "7"}
  AddInvoice(InvoiceForm(form)?, "Élodie Bo", 0, s.Db)?
  form.price1 = "900"
  AddInvoice(InvoiceForm(form)?, "Élodie Bo", 0, s.Db)?
  form.date = "2026-10-01"
  form.price1 = "7"
  AddInvoice(InvoiceForm(form)?, "Élodie Bo", 0, s.Db)?
  ok = true
  for sort in InvoiceSorts
    f = all
    f.Sort = sort
    whole = InvoicesPage(f, now, missing, 100, s.Db)?
    one = InvoicesPage(f, now, missing, 2, s.Db)?
    two = InvoicesPage(f, now, one.Next, 2, s.Db)?
    old(r) = {Invoice: r.Invoice, Number: r.Number, Status: r.Status, Due: r.Due, X: if sort == "-total" r.Total else r.Date end}
    after = InvoicesPage(f, now, {After: old(one.Rows[2])}, 2, s.Db)?
    link = Cursor({after: text.Split("=", Link({After: old(one.Rows[2])}))[2] then encode.UrlDecode})
    linked = InvoicesPage(f, now, link, 2, s.Db)?
    before = InvoicesPage(f, now, {Before: old(two.Rows[1])}, 2, s.Db)?
    bug.Assert(value.Equal([r.Invoice for r in whole.Rows], oldOrder(f, s.Db)?), "the order of the pages kept: $sort")
    bug.Assert(value.Equal(list.Sort(dict.Keys(one.Next.After)), ["BillTo", "Date", "Due", "Invoice", "Number", "Status", "Total"]), "a cursor of seven fields")
    ok = ok and value.Equal(after.Rows, two.Rows) and value.Equal(linked.Rows, two.Rows) and value.Equal(before.Rows, one.Rows)
  end
  f = all
  one = InvoicesPage(f, now, missing, 2, s.Db)?
  two = InvoicesPage(f, now, one.Next, 2, s.Db)?
  gone = {After: {Invoice: one.Rows[2].Invoice, Number: one.Rows[2].Number, Status: one.Rows[2].Status, Due: one.Rows[2].Due, X: one.Rows[2].Date}}
  DeleteInvoice(one.Rows[2].Invoice, 0, s.Db)?
  ok and value.Equal(InvoicesPage(f, now, gone, 2, s.Db)?.Rows, two.Rows)
end

defn isLatestPaymentsWatched()
  (** The dashboard's payments: the ten latest, newest first; a payment comes in at the top and pushes the tenth out;
      one that leaves the ten (here its date moved back) lets the next one in. *)
  s = shop()?
  ids = [s.One.Invoice, s.Two.Invoice, s.Three.Invoice]
  form = {client: "$(s.Bo)", date: "2026-10-02", due: "2026-10-31", label1: "Box", quantity1: "1", price1: "7"}
  for k in 1..9
    ids = list.Append(AddInvoice(InvoiceForm(form)?, "Élodie Bo", 0, s.Db)?.Invoice, ids)
  end
  for k in 1..11
    PayInvoice(ids[k], now + k, 0, s.Db)?
  end
  w = cepheus.Watch(5, LatestPayments, s.Db)?
  first = fiber.Receive(w.Changes)?
  PayInvoice(ids[12], now + 12, 0, s.Db)?
  came = fiber.Receive(w.Changes)?
  cepheus.Write([cepheus.Retract(ids[12], Invoice.PaidAt, now + 12), cepheus.Add(ids[12], Invoice.PaidAt, now - 1)], s.Db)?
  went = fiber.Receive(w.Changes)?
  cepheus.Close(w)
  bug.Assert(value.Equal([r.PaidAt for r in first.Rows], list.Reverse([now + k for k in 2..11])), "the ten latest, newest first")
  bug.Assert(value.Equal([r.Invoice for r in came.Added], [ids[12]]) and value.Equal([r.Invoice for r in came.Removed], [ids[2]]), "one in, the tenth out")
  value.Equal([r.Invoice for r in went.Removed], [ids[12]]) and value.Equal([r.Invoice for r in went.Added], [ids[2]])
end

defn isNumberedInOrderAtOnce()
  (** 20 invoices made at once by 20 fibers: numbers 1 to 20, each once. *)
  t = cepheus.Fork(cepheus.Empty, Kinds)?
  ada = AddClient(ClientForm({name: "Ada", email: "ada@example.com", city: "Lyon"})?, 0, t)?
  f = InvoiceForm({client: "$ada", date: "2026-10-01", due: "2026-10-31", label1: "A", quantity1: "1", price1: "1"})?
  tasks = [fiber.Spawn(() -> AddInvoice(f, "Ada", 0, t)) for k in 1..20]
  numbers = [cepheus.Get(Invoice, result.Unwrap(fiber.Wait(x))?.Invoice, t)?.Number for x in tasks]
  value.Equal(list.Sort(numbers), [k for k in 1..20])
end

defn isNumberedAfterNumbersMadeWithoutTheCounter()
  (** Invoices numbered without the counter, as the seed does: made after them, the counter starts after them; behind
      them, the next invoice catches up once; CatchUpNumbers moves it up. *)
  t = cepheus.Fork(cepheus.Empty, Kinds)?
  ada = AddClient(ClientForm({name: "Ada", email: "ada@example.com", city: "Lyon"})?, 0, t)?
  f = InvoiceForm({client: "$ada", date: "2026-10-01", due: "2026-10-31", label1: "A", quantity1: "1", price1: "1"})?
  byHand(n) = cepheus.Write([cepheus.Add(cepheus.New(1), Invoice.Number, n)], t)
  byHand(1)?
  byHand(2)?
  third = cepheus.Get(Invoice, AddInvoice(f, "Ada", 0, t)?.Invoice, t)?.Number
  byHand(4)?
  fifth = cepheus.Get(Invoice, AddInvoice(f, "Ada", 0, t)?.Invoice, t)?.Number
  byHand(6)?
  CatchUpNumbers(t)?
  CatchUpNumbers(t)?
  seventh = cepheus.Get(Invoice, AddInvoice(f, "Ada", 0, t)?.Invoice, t)?.Number
  value.Equal([third, fifth, seventh], [3, 5, 7])
end
