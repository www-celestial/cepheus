(* The style and the script of the pages, served by the app at /app.css and /app.js, so that no page holds inline code.
   The script does two things: the search of clients as one types (it asks /clients?part=rows for the rows, which the
   server escaped), and the dashboard's numbers, which std/live's live.js keeps up to date. It writes every value with
   textContent, never as HTML. *)

Style = "body { font: 15px/1.45 system-ui, sans-serif; margin: 0; color: #1d2125; background: #f6f7f9; }
nav { display: flex; gap: 1rem; align-items: center; padding: .6rem 1.2rem; background: #0c8599; }
nav a, nav .who { color: #fff; text-decoration: none; } nav .who { margin-left: auto; opacity: .85; }
nav form { margin: 0; } main { max-width: 1100px; margin: 0 auto; padding: 1rem 1.2rem 3rem; }
table { border-collapse: collapse; width: 100%; background: #fff; } th, td { text-align: left; padding: .35rem .6rem; border-bottom: 1px solid #e3e6ea; }
.num { text-align: right; font-variant-numeric: tabular-nums; } .card { background: #fff; padding: 1rem; max-width: 640px; display: grid; gap: .6rem; }
label { display: grid; gap: .2rem; } .bar { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; margin: .6rem 0; } .bar label { display: inline; }
input, select, button, .button { font: inherit; padding: .3rem .5rem; } .button { display: inline-block; background: #e3e6ea; color: inherit; text-decoration: none; border-radius: 3px; }
button { cursor: pointer; } .danger { color: #c92a2a; } .error { color: #c92a2a; } .muted { color: #6c757d; }
.badge { padding: .05rem .45rem; border-radius: 3px; background: #e3e6ea; } .badge.paid { background: #d3f9d8; } .badge.late { background: #ffe3e3; } .badge.unpaid { background: #fff3bf; }
.tiles { display: flex; gap: 1rem; flex-wrap: wrap; } .tile { background: #fff; padding: .4rem 1.2rem; min-width: 260px; } .big { font-size: 2rem; margin: .2rem 0; }
.pager { display: flex; gap: 1rem; } .actions { display: flex; gap: .6rem; margin-top: 1rem; } .actions form { margin: 0; }
"

Script = "// The app's script: the search as one types, and the dashboard's live numbers.
const q = document.querySelector('#q[data-live]')
if (q) {
  let timer = null
  q.addEventListener('input', () => {
    clearTimeout(timer)
    timer = setTimeout(async () => {
      const r = await fetch('/clients?part=rows&q=' + encodeURIComponent(q.value))
      if (r.ok) document.querySelector('#rows').innerHTML = await r.text()
    }, 100)
  })
}

const board = document.querySelector('#dashboard')
if (board) {
  const { connect } = await import('/live/live.js')
  const state = document.querySelector('#live-state')
  const money = x => x.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
  const tile = (id, rows) => {
    const r = rows[0] || { Total: 0, Count: 0 }
    document.querySelector('#' + id).textContent = money(r.Total)
    document.querySelector('#' + id + '-count').textContent = r.Count + (r.Count === 1 ? ' invoice' : ' invoices')
  }
  const cell = (text, cls) => { const td = document.createElement('td'); td.textContent = text; if (cls) td.className = cls; return td }
  try {
    const live = await connect('/live')
    state.textContent = 'live'
    live.onError(e => { state.textContent = 'error: ' + (e.Message || e) })
    live.show('unpaid', rows => tile('unpaid', rows))
    live.show('late', rows => tile('late', rows))
    // the ten latest payments, the watch's rows: live.js holds them as a set, so they are put in its order again
    live.show('payments', rows => {
      const latest = rows.slice().sort((a, b) => b.PaidAt - a.PaidAt || b.Number - a.Number)
      document.querySelector('#payments').replaceChildren(...latest.map(r => {
        const tr = document.createElement('tr')
        const a = document.createElement('a')
        a.href = '/invoices/' + r.Invoice
        a.textContent = String(r.Number)
        const first = cell('')
        first.append(a)
        tr.append(first, cell(r.BillTo), cell(new Date(r.PaidAt * 1000).toISOString().slice(0, 16).replace('T', ' ')), cell(money(r.Total), 'num'))
        return tr
      }))
    })
  } catch (e) {
    state.textContent = 'not live: ' + (e.Message || e)
  }
}
"
