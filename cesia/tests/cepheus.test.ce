(* The package cepheus on forks of Empty: every function, its errors, and what a fork promises (G8), with no server. *)
use cesia/cepheus
use std/bug
use std/fiber
use std/io
use std/list
use std/math
use std/random
use std/result
use std/text
use std/value

Client = cepheus.Kind("client", {Name: cepheus.Text(), City: cepheus.Text(), Email: cepheus.Text(unique = true), Tags: cepheus.Text(many = true)})
Invoice = cepheus.Kind("invoice", {Client: cepheus.Link(), Total: cepheus.Money(2), Status: cepheus.Text(), Due: cepheus.Date(), Paid: cepheus.Bool(), Lines: cepheus.Int()})

defn shop()
  (** A fork with two clients and three invoices. *)
  t = cepheus.Fork(cepheus.Empty, [Client, Invoice])?
  ada = cepheus.Insert(Client, {Name: "Ada", City: "Lyon", Email: "ada@x.fr", Tags: ["vip", "early"]}, t)?
  bo = cepheus.Insert(Client, {Name: "Bo", City: "Paris", Email: "bo@x.fr"}, t)?
  cepheus.Insert(Invoice, {Client: ada, Total: 1200, Status: "unpaid", Due: 1794268800, Lines: 3}, t)?
  cepheus.Insert(Invoice, {Client: ada, Total: 80.5, Status: "unpaid", Due: 1794355200.25, Lines: 1}, t)?
  cepheus.Insert(Invoice, {Client: bo, Total: 10, Status: "paid", Paid: true, Lines: 1}, t)?
  result.Ok({Db: t, Ada: ada, Bo: bo})
end

defn isGetGivesTheFields()
  s = shop()?
  value.Equal(cepheus.Get(Client, s.Ada, s.Db)?, {Name: "Ada", City: "Lyon", Email: "ada@x.fr", Tags: ["vip", "early"]})
end

defn isGetOfNothing()
  s = shop()?
  cepheus.Get(Client, 999, s.Db)? == missing
end

defn isTypesComeBack()
  s = shop()?
  rows = cepheus.Find(2, (i, due) -> {Where: [[i, Invoice.Due, due], [i, Invoice.Lines, 1]], Give: {Due: due}}, s.Db)?
  inv = cepheus.Find(1, (i) -> {Where: [[i, Invoice.Paid, true]], Give: {I: i}}, s.Db)?[1].I
  got = cepheus.Get(Invoice, inv, s.Db)?
  bug.Assert(value.Equal(rows, [{Due: 1794355200.25}]), "a date keeps its milliseconds")
  got.Total == 10.0 and got.Paid == true and got.Due == missing and got.Client == s.Bo
end

defn isFindJoins()
  s = shop()?
  rows = cepheus.Find(3, (c, i, total) -> {
    Where: [[c, Client.City, "Lyon"], [i, Invoice.Client, c], [i, Invoice.Status, "unpaid"], [i, Invoice.Total, total]],
    Give: {Total: total},
  }, s.Db)?
  value.Equal(list.Sort([r.Total for r in rows]), [80.5, 1200.0])
end

defn isFindAggregates()
  s = shop()?
  rows = cepheus.Find(4, (c, i, city, total) -> {
    Where: [[i, Invoice.Client, c], [c, Client.City, city], [i, Invoice.Total, total]],
    Give: {City: city, Unpaid: cepheus.Sum(total), Count: cepheus.Count(), Least: cepheus.Min(total), Most: cepheus.Max(total)},
  }, s.Db)?
  value.Equal(rows, [{City: "Lyon", Unpaid: 1280.5, Count: 2, Least: 80.5, Most: 1200.0}, {City: "Paris", Unpaid: 10.0, Count: 1, Least: 10.0, Most: 10.0}])
end

defn isFindRanges()
  s = shop()?
  above(v) = cepheus.Find(2, (i, t) -> {Where: [[i, Invoice.Total, t], cepheus.Above(t, v)], Give: {T: t}}, s.Db)?
  between = cepheus.Find(2, (i, t) -> {Where: [[i, Invoice.Total, t], cepheus.Between(t, 10, 80.5)], Give: {T: t}}, s.Db)?
  below = cepheus.Find(2, (i, t) -> {Where: [[i, Invoice.Total, t], cepheus.Below(t, 80.5)], Give: {T: t}}, s.Db)?
  bug.Assert(value.Len(above(80.5)) == 1, "cepheus.Above is strict")
  bug.Assert(value.Len(between) == 2, "cepheus.Between holds its bounds")
  value.Equal(below, [{T: 10.0}])
end

Item = cepheus.Kind("item", {Price: cepheus.Money(2), When: cepheus.Date(), N: cepheus.Int()})

defn items()
  (** A fork with three items: prices 10.00, 10.01 and 10.02, dates 1.000, 1.001 and 1.002 s, numbers 1, 2 and 3. *)
  t = cepheus.Fork(cepheus.Empty, [Item])?
  cepheus.Insert(Item, {Price: 10.00, When: 1.000, N: 1}, t)?
  cepheus.Insert(Item, {Price: 10.01, When: 1.001, N: 2}, t)?
  cepheus.Insert(Item, {Price: 10.02, When: 1.002, N: 3}, t)?
  result.Ok(t)
end

defn isRangeBoundsRoundInside()
  (** A bound between two cents or two milliseconds is rounded toward the inside of the range, one at a cent or a
      millisecond stays exact, and Above the largest Int or Below the least is empty: the rows they gave before are
      wrong. *)
  t = items()?
  prices(cond) = [r.P for r in cepheus.Find(2, (i, p) -> {Where: [[i, Item.Price, p], cond(p)], Give: {P: p}, Sort: [p]}, t)?]
  dates(cond) = [r.D for r in cepheus.Find(2, (i, d) -> {Where: [[i, Item.When, d], cond(d)], Give: {D: d}, Sort: [d]}, t)?]
  ints(cond) = [r.N for r in cepheus.Find(2, (i, n) -> {Where: [[i, Item.N, n], cond(n)], Give: {N: n}, Sort: [n]}, t)?]
  bug.Assert(value.Equal(prices((p) -> cepheus.Above(p, 10.005)), [10.01, 10.02]), "Above(price, 10.005)")
  bug.Assert(value.Equal(prices((p) -> cepheus.Below(p, 10.004)), [10.0]), "Below(price, 10.004)")
  bug.Assert(value.Equal(prices((p) -> cepheus.Between(p, 10.004, 10.016)), [10.01]), "Between(price, 10.004, 10.016)")
  bug.Assert(value.Equal(prices((p) -> cepheus.Between(p, 10.005, 10.005)), []), "Between(price, 10.005, 10.005)")
  bug.Assert(value.Equal(prices((p) -> cepheus.Above(p, 10.01)), [10.02]), "Above(price, 10.01): 10.01 times 100 is 1000.9999999999999")
  bug.Assert(value.Equal(prices((p) -> cepheus.Below(p, 10.01)), [10.0]), "Below(price, 10.01)")
  bug.Assert(value.Equal(prices((p) -> cepheus.Between(p, 10.01, 10.02)), [10.01, 10.02]), "Between(price, 10.01, 10.02)")
  bug.Assert(value.Equal(prices((p) -> cepheus.Above(p, 10)), [10.01, 10.02]), "Above(price, 10), an Int")
  bug.Assert(value.Equal(dates((d) -> cepheus.Above(d, 1.0005)), [1.001, 1.002]), "Above(when, 1.0005)")
  bug.Assert(value.Equal(dates((d) -> cepheus.Below(d, 1.0004)), [1.0]), "Below(when, 1.0004)")
  bug.Assert(value.Equal(dates((d) -> cepheus.Between(d, 1.0004, 1.0016)), [1.001]), "Between(when, 1.0004, 1.0016)")
  bug.Assert(value.Equal(dates((d) -> cepheus.Above(d, 1.001)), [1.002]), "Above(when, 1.001)")
  bug.Assert(value.Equal(dates((d) -> cepheus.Below(d, 1)), []), "Below(when, 1), an Int")
  bug.Assert(value.Equal(ints((n) -> cepheus.Above(n, 4611686018427387903)), []), "Above(n, the largest Int)")
  bug.Assert(value.Equal(ints((n) -> cepheus.Below(n, -4611686018427387903 - 1)), []), "Below(n, the least Int)")
  bug.Assert(value.Equal(ints((n) -> cepheus.Above(n, 4611686018427387902)), []), "Above(n, the largest Int less 1)")
  bug.Assert(value.Equal(ints((n) -> cepheus.Below(n, 4611686018427387903)), [1, 2, 3]), "Below(n, the largest Int)")
  bug.Assert(value.Equal(ints((n) -> cepheus.Above(n, -4611686018427387903 - 1)), [1, 2, 3]), "Above(n, the least Int)")
  bug.Assert(value.Equal(ints((n) -> cepheus.Between(n, 3, 1)), []), "Between(n, 3, 1)")
  value.Equal(ints((n) -> cepheus.Between(n, -4611686018427387903 - 1, 4611686018427387903)), [1, 2, 3])
end

defn isRangeBoundsAsANaiveFilter()
  (** Random prices and dates, and random bounds of Above, Below and Between, at a cent or a millisecond and between
      two: the rows are those a filter of every value keeps, comparing whole cents or milliseconds with the bound
      scaled to them. *)
  t = cepheus.Fork(cepheus.Empty, [Item])?
  cents = [random.Int(-500, 500) for k in 1..40]
  for c in cents
    cepheus.Insert(Item, {Price: c / 100, When: c / 1000}, t)?
  end
  bound() = random.Int(-520, 520) if random.Int(0, 1) == 0 else random.Int(-520, 519) + 0.1 + random.Float() * 0.8
  ok = true
  for k in 1..150
    a = bound()
    b = bound()
    pick = random.Int(1, 3)
    keep(c) = (c > a) if pick == 1 else ((c < a) if pick == 2 else (c >= a and c <= b))
    cond(x, u) = cepheus.Above(x, a / u) if pick == 1 else (cepheus.Below(x, a / u) if pick == 2 else cepheus.Between(x, a / u, b / u))
    want = list.Sort([c * 1.0 for c in cents if keep(c)])
    p = [math.Round(r.P * 100) for r in cepheus.Find(2, (i, x) -> {Where: [[i, Item.Price, x], cond(x, 100)], Give: {I: i, P: x}}, t)?]
    d = [math.Round(r.D * 1000) for r in cepheus.Find(2, (i, x) -> {Where: [[i, Item.When, x], cond(x, 1000)], Give: {I: i, D: x}}, t)?]
    if not value.Equal(list.Sort(p), want) or not value.Equal(list.Sort(d), want)
      io.Print("seed", random.Seed(), "condition", pick, "bounds", a, b, "want", want, "prices", list.Sort(p), "dates", list.Sort(d))
      ok = false
    end
  end
  ok
end

defn isDatesAndMoneyThatDoNotFitRefused()
  (** A date whose milliseconds pass the Ints, and money of the least Int, are refused: they were stored wrapped
      around (5e15 s read back as -4.2e15, the least Int's cents as 0). The largest that fit are kept. *)
  t = items()?
  far = cepheus.Insert(Item, {When: 5000000000000000.0}, t)
  past = cepheus.Insert(Item, {When: -5000000000000000.0}, t)
  edge = cepheus.Insert(Item, {When: 4611686018427387.0}, t)
  least = cepheus.Insert(Item, {Price: -4611686018427387903 - 1}, t)
  most = cepheus.Insert(Item, {Price: 46116860184273879}, t)
  fits = cepheus.Insert(Item, {When: -4611686018427386.0, Price: -46116860184273878}, t)
  list.All([far.Error.Code == "invalid", past.Error.Code == "invalid", edge.Error.Code == "invalid",
            least.Error.Code == "invalid", most.Error.Code == "invalid", result.IsOk(fits)])
end

defn isFindSorts()
  s = shop()?
  q(after) = (i, t) -> {Where: [[i, Invoice.Total, t]], Give: {I: i, Total: t}, Sort: [cepheus.Desc(t)], Limit: 2, After: after}
  first = cepheus.Find(2, q(missing), s.Db)?
  next = cepheus.Find(2, q(first[2]), s.Db)?
  last = cepheus.Find(2, q(next[1]), s.Db)?
  bug.Assert(value.Equal([r.Total for r in first], [1200.0, 80.5]), "the largest first, two rows")
  bug.Assert(value.Equal([r.Total for r in next], [10.0]), "the page after the last row seen")
  value.Len(last) == 0
end

defn isFindSortsGroups()
  s = shop()?
  rows = cepheus.Find(4, (c, i, t, n) -> {
    Where: [[i, Invoice.Client, c], [c, Client.Name, n], [i, Invoice.Total, t]],
    Give: {Name: n, Owed: cepheus.Sum(t)},
    Sort: [cepheus.Desc(cepheus.Sum(t))],
    Limit: 1,
  }, s.Db)?
  value.Equal(rows, [{Name: "Ada", Owed: 1280.5}])
end

defn isFindLimitKeepsCopies()
  s = shop()?
  (* Ada's two invoices give her name twice: a page never splits the copies of its last row *)
  rows = cepheus.Find(3, (c, i, n) -> {Where: [[i, Invoice.Client, c], [c, Client.Name, n]], Give: {Name: n}, Sort: [n], Limit: 1}, s.Db)?
  value.Equal(rows, [{Name: "Ada"}, {Name: "Ada"}])
end

defn isFindSortRefusals()
  s = shop()?
  notGiven = cepheus.Find(2, (i, t) -> {Where: [[i, Invoice.Total, t]], Give: {I: i}, Sort: [t]}, s.Db)
  noSort = cepheus.Find(2, (i, t) -> {Where: [[i, Invoice.Total, t]], Give: {T: t}, After: {T: 10}}, s.Db)
  short = cepheus.Find(2, (i, t) -> {Where: [[i, Invoice.Total, t]], Give: {I: i, T: t}, Sort: [t], After: {T: 10}}, s.Db)
  watch = cepheus.Watch(2, (i, t) -> {Where: [[i, Invoice.Total, t]], Give: {T: t}, Sort: [t], After: {T: 10}}, s.Db)
  misspelt = cepheus.Find(2, (i, t) -> {Where: [[i, Invoice.Total, t]], Give: {T: t}, Sort: [t], Afer: {T: 10}}, s.Db)
  old = cepheus.Find(2, (i, t) -> {Where: [[i, Invoice.Total, t]], Give: {T: t}, Note: "kept"}, s.Db)
  bug.Assert(misspelt.Error.Code == "invalid" and result.IsOk(old), "an unknown key beside Sort is refused, and only there")
  list.All([notGiven.Error.Code == "invalid", noSort.Error.Code == "invalid", short.Error.Code == "invalid", watch.Error.Code == "invalid"])
end

defn isFindNot()
  s = shop()?
  (* the clients with no unpaid invoice: i is the Not's own *)
  clear = cepheus.Find(2, (c, i) -> {Where: [[c, Client.Name, "Bo"], cepheus.Not([i, Invoice.Client, c], [i, Invoice.Status, "unpaid"])], Give: {C: c}}, s.Db)?
  owing = cepheus.Find(2, (c, i) -> {Where: [[c, Client.Name, "Ada"], cepheus.Not([i, Invoice.Client, c], [i, Invoice.Status, "unpaid"])], Give: {C: c}}, s.Db)?
  untagged = cepheus.Find(2, (c, t) -> {Where: [[c, Client.Email, t], cepheus.Not([c, Client.Tags, "vip"])], Give: {C: c}}, s.Db)?
  value.Equal(clear, [{C: s.Bo}]) and value.Len(owing) == 0 and value.Equal(untagged, [{C: s.Bo}])
end

defn isFindOr()
  s = shop()?
  (* Ada by her tag, Bo by his city, each once though Ada is both *)
  rows = cepheus.Find(1, (c) -> {Where: [cepheus.Or([c, Client.Tags, "vip"], [c, Client.City, "Paris"], [c, Client.Name, "Ada"])], Give: {C: c}}, s.Db)?
  big = cepheus.Find(2, (i, t) -> {Where: [cepheus.Or([i, Invoice.Paid, true], cepheus.And([i, Invoice.Total, t], cepheus.Above(t, 1000)))], Give: {I: i}}, s.Db)?
  bug.Assert(value.Equal(list.Sort([r.C for r in rows]), list.Sort([s.Ada, s.Bo])), "each client once")
  value.Len(big) == 2
end

defn isFindIn()
  s = shop()?
  rows = cepheus.Find(2, (i, st) -> {Where: [[i, Invoice.Status, st], cepheus.In(st, ["paid", "late"])], Give: {I: i}}, s.Db)?
  mine = cepheus.Find(2, (i, c) -> {Where: [[i, Invoice.Client, c], cepheus.In(c, [s.Bo, 99999])], Give: {I: i}}, s.Db)?
  value.Len(rows) == 1 and value.Equal(rows, mine)
end

defn isFindPrefix()
  s = shop()?
  a = cepheus.Find(2, (c, n) -> {Where: [[c, Client.Name, n], cepheus.Prefix(n, "A")], Give: {C: c}}, s.Db)?
  none = cepheus.Find(2, (c, n) -> {Where: [[c, Client.Name, n], cepheus.Prefix(n, "a")], Give: {C: c}}, s.Db)?
  inNot = cepheus.Find(2, (c, e) -> {Where: [[c, Client.City, "Lyon"], cepheus.Not([c, Client.Email, e], cepheus.Prefix(e, "ada@"))], Give: {C: c}}, s.Db)?
  empty = cepheus.Find(2, (c, n) -> {Where: [[c, Client.Name, n], cepheus.Prefix(n, "")], Give: {C: c}}, s.Db)
  list.All([value.Equal(a, [{C: s.Ada}]), value.Len(none) == 0, value.Len(inNot) == 0, empty.Error.Code == "invalid"])
end

defn isFindOperatorRefusals()
  s = shop()?
  andTop = cepheus.Find(1, (c) -> {Where: [cepheus.And([c, Client.Name, "Ada"])], Give: {C: c}}, s.Db)
  inCase = cepheus.Find(1, (c) -> {Where: [cepheus.Or([c, Client.City, "Lyon"], [c, Client.City, "Paris"])], Give: {C: c}}, s.Db)
  own = cepheus.Find(2, (c, i) -> {Where: [[c, Client.Name, "Ada"], cepheus.Not([i, Invoice.Client, c])], Give: {I: i}}, s.Db)
  list.All([andTop.Error.Code == "invalid", inCase.Error.Code == "invalid", own.Error.Code == "invalid"])
end

defn isFindTimeout()
  (** A cross product of three patterns over 400 clients (64 million answers) given 0.05 s ends timeout, its message
      naming the time; the same question of one pattern answers within 5 s; a time of 0 is a mistake. *)
  t = cepheus.Fork(cepheus.Empty, [Client])?
  cepheus.Write([cepheus.Add(cepheus.New(k), Client.Name, "c$k") for k in 1:400], t)?
  cross = cepheus.Find(6, (a, x, b, y, c, z) -> {Where: [[a, Client.Name, x], [b, Client.Name, y], [c, Client.Name, z]], Give: {N: cepheus.Count()}}, t, timeout = 0.05)
  one = cepheus.Find(2, (a, x) -> {Where: [[a, Client.Name, x]], Give: {N: cepheus.Count()}}, t, timeout = 5)?
  bug.Assert(cross.Error.Code == "timeout" and text.Contains("0.05 s", cross.Error.Message), "$cross")
  one[1].N == 400
end

defn isFindLeavesOutAnUnusedVariable()
  (** A variable in no item of the question, as an optional filter left out, is left out; one Give names but no
      pattern binds is refused by its field. *)
  s = shop()?
  q(city) = (c, n, y) -> {Where: list.Concat([[c, Client.Name, n]], if city == missing [] else [[c, Client.City, y], cepheus.Prefix(y, city)] end), Give: {Name: n}}
  all = cepheus.Find(3, q(missing), s.Db)?
  lyon = cepheus.Find(3, q("Ly"), s.Db)?
  loose = cepheus.Find(2, (c, n) -> {Where: [[c, Client.City, "Lyon"]], Give: {Name: n}}, s.Db)
  bug.Assert(loose.Error.Code == "invalid" and text.Contains("Give's Name", loose.Error.Message), loose.Error.Message)
  value.Equal(list.Sort([r.Name for r in all]), ["Ada", "Bo"]) and value.Equal(lyon, [{Name: "Ada"}])
end

defn isFindManyValues()
  s = shop()?
  value.Equal(cepheus.Find(1, (c) -> {Where: [[c, Client.Tags, "vip"]], Give: {C: c}}, s.Db)?, [{C: s.Ada}])
end

defn isWriteAllOrNothing()
  s = shop()?
  t = s.Db
  inv = cepheus.Find(1, (i) -> {Where: [[i, Invoice.Total, 1200]], Give: {I: i}}, t)?[1].I
  paid = cepheus.Write([cepheus.Expect(inv, Invoice.Status, "unpaid"), cepheus.Add(inv, Invoice.Status, "paid")], t, by = 7, why = "pay")?
  again = cepheus.Write([cepheus.Expect(inv, Invoice.Status, "unpaid"), cepheus.Add(inv, Invoice.Status, "paid"), cepheus.Add(inv, Invoice.Lines, 9)], t)
  bug.Assert(value.Len(paid.Things) == 0, "no new thing")
  bug.Assert(again.Error.Code == "conflict", "the second payment is refused")
  got = cepheus.Get(Invoice, inv, t)?
  got.Status == "paid" and got.Lines == 3
end

defn isNewThingsOfAGroup()
  s = shop()?
  r = cepheus.Write([cepheus.Add(cepheus.New(1), Client.Name, "Cy"), cepheus.Add(cepheus.New(2), Invoice.Client, cepheus.New(1)), cepheus.Add(cepheus.New(2), Invoice.Total, 5)], s.Db)?
  bug.Assert(value.Len(r.Things) == 2, "two new things")
  cepheus.Get(Invoice, r.Things[2], s.Db)?.Client == r.Things[1]
end

Counter = cepheus.Kind("counter", {Name: cepheus.Text(), Last: cepheus.Int()})
Ticket = cepheus.Kind("ticket", {Number: cepheus.Int(unique = true), Label: cepheus.Text()})

defn isIncrNumbersWithoutAGap()
  (** 30 fibers at once each make a ticket numbered by the counter, in its own group: 1 to 30, each once, no retry *)
  t = cepheus.Fork(cepheus.Empty, [Counter, Ticket])?
  c = cepheus.Insert(Counter, {Name: "tickets"}, t)?
  make(k) = cepheus.Write([cepheus.Incr(c, Counter.Last, into = [cepheus.New(1), Ticket.Number]), cepheus.Add(cepheus.New(1), Ticket.Label, "ticket $(k)")], t)
  tasks = [fiber.Spawn(() -> make(k)) for k in 1..30]
  tickets = [result.Unwrap(fiber.Wait(x))?.Things[1] for x in tasks]
  numbers = [cepheus.Get(Ticket, b, t)?.Number for b in tickets]
  value.Equal(list.Sort(numbers), [k for k in 1..30]) and cepheus.Get(Counter, c, t)?.Last == 30
end

defn isIncrRefusedLeavesTheCounter()
  (** a refused group takes no number; by counts down too; past the 63 bits, refused *)
  t = cepheus.Fork(cepheus.Empty, [Counter, Ticket])?
  c = cepheus.Insert(Counter, {Name: "tickets", Last: 5}, t)?
  refused = cepheus.Write([cepheus.Incr(c, Counter.Last), cepheus.Expect(c, Counter.Name, "other")], t)
  cepheus.Write([cepheus.Incr(c, Counter.Last, by = -2)], t)?
  big = cepheus.Insert(Counter, {Last: 4611686018427387903}, t)?
  over = cepheus.Write([cepheus.Incr(big, Counter.Last)], t)
  wrong = cepheus.Write([cepheus.Incr(c, Counter.Name)], t)
  intoText = cepheus.Write([cepheus.Incr(c, Counter.Last, into = [c, Counter.Name])], t)
  list.All([refused.Error.Code == "conflict", cepheus.Get(Counter, c, t)?.Last == 3, over.Error.Code == "invalid",
            wrong.Error.Code == "invalid", intoText.Error.Code == "invalid", cepheus.Get(Counter, c, t)?.Last == 3])
end

defn isUniqueAndRetract()
  s = shop()?
  taken = cepheus.Insert(Client, {Name: "Eve", Email: "ada@x.fr"}, s.Db)
  cepheus.Write([cepheus.Retract(s.Ada, Client.Email, "ada@x.fr")], s.Db)?
  free = cepheus.Insert(Client, {Name: "Eve", Email: "ada@x.fr"}, s.Db)
  taken.Error.Code == "unique" and result.IsOk(free)
end

defn isUpdate()
  s = shop()?
  cepheus.Update(Client, s.Bo, {City: "Lyon"}, s.Db)?
  many = cepheus.Update(Client, s.Bo, {Tags: ["x"]}, s.Db)
  cepheus.Get(Client, s.Bo, s.Db)?.City == "Lyon" and many.Error.Code == "invalid"
end

defn isMistakesAreErrors()
  s = shop()?
  wrongField = cepheus.Insert(Client, {Nme: "x"}, s.Db)
  wrongType = cepheus.Insert(Client, {Name: 3}, s.Db)
  undeclared = cepheus.Fork(cepheus.Empty)?
  noKind = cepheus.Get(Client, 1, undeclared)
  list.All([wrongField.Error.Code == "invalid", wrongType.Error.Code == "invalid", noKind.Error.Code == "invalid"])
end

defn isAForkNeverChangesItsOrigin()
  s = shop()?
  t = cepheus.Fork(s.Db)?
  cepheus.Update(Client, s.Ada, {City: "Nice"}, t)?
  cepheus.Get(Client, s.Ada, t)?.City == "Nice" and cepheus.Get(Client, s.Ada, s.Db)?.City == "Lyon"
end

defn isClosed()
  s = shop()?
  cepheus.Close(s.Db)
  cepheus.Get(Client, s.Ada, s.Db).Error.Code == "closed"
end

defn isConnectNeedsAnAddress()
  far = cepheus.Connect("cepheus://example.invalid:7400/shop", [Client])
  far.Error.Code == "invalid"
end

defn isWatchGivesTheAnswerThenChanges()
  s = shop()?
  w = cepheus.Watch(2, (i, total) -> {Where: [[i, Invoice.Status, "unpaid"], [i, Invoice.Total, total]], Give: {Invoice: i, Total: total}}, s.Db)?
  first = fiber.Receive(w.Changes)?
  id = cepheus.Insert(Invoice, {Client: s.Bo, Total: 90, Status: "unpaid"}, s.Db)?
  added = fiber.Receive(w.Changes)?
  cepheus.Update(Invoice, id, {Status: "paid"}, s.Db)?
  removed = fiber.Receive(w.Changes)?
  cepheus.Close(w)
  closed = fiber.Receive(w.Changes)
  bug.Assert(value.Len(first.Rows) == 2, "the answer first")
  bug.Assert(value.Equal(added.Added, [{Invoice: id, Total: 90.0}]) and value.Len(added.Removed) == 0, "a row added")
  bug.Assert(value.Equal(removed.Removed, [{Invoice: id, Total: 90.0}]) and value.Len(removed.Added) == 0, "a row removed")
  bug.Assert(removed.Group == added.Group + 1, "each change has its group")
  closed.Error.Kind == "closed"
end

defn isWatchSharedByFibers()
  s = shop()?
  q = (i) -> {Where: [[i, Invoice.Status, "unpaid"]], Give: {Invoice: i}}
  a = cepheus.Watch(1, q, s.Db)?
  b = cepheus.Watch(1, q, s.Db)?
  fiber.Receive(a.Changes)?
  fiber.Receive(b.Changes)?
  id = cepheus.Insert(Invoice, {Client: s.Bo, Total: 5, Status: "unpaid"}, s.Db)?
  x = fiber.Receive(a.Changes)?
  y = fiber.Receive(b.Changes)?
  cepheus.Close(a)
  cepheus.Close(b)
  value.Equal(x.Added, [{Invoice: id}]) and value.Equal(y.Added, [{Invoice: id}])
end

defn isWatchKeepsTheFirstRowsInOrder()
  (** Sort and Limit in a watch: Find's rows, in the order, as they change; a row that leaves the window is replaced
      by the next one. *)
  s = shop()?
  w = cepheus.Watch(2, (i, t) -> {Where: [[i, Invoice.Total, t]], Give: {Invoice: i, Total: t}, Sort: [cepheus.Desc(t)], Limit: 2}, s.Db)?
  first = fiber.Receive(w.Changes)?
  big = cepheus.Insert(Invoice, {Client: s.Bo, Total: 500, Status: "unpaid"}, s.Db)?
  came = fiber.Receive(w.Changes)?
  small = cepheus.Insert(Invoice, {Client: s.Bo, Total: 1, Status: "unpaid"}, s.Db)?
  cepheus.Update(Invoice, big, {Total: 5}, s.Db)?
  went = fiber.Receive(w.Changes)?
  cepheus.Close(w)
  bug.Assert(value.Equal([r.Total for r in first.Rows], [1200.0, 80.5]), "the first two, the largest first")
  bug.Assert(value.Equal(came.Added, [{Invoice: big, Total: 500.0}]) and value.Equal([r.Total for r in came.Removed], [80.5]), "a row in, the last out")
  bug.Assert(went.Group == came.Group + 2, "a row after the window: no change")
  value.Equal(went.Removed, [{Invoice: big, Total: 500.0}]) and value.Equal([r.Total for r in went.Added], [80.5]) and small > 0
end

defn isWatchSortRefusals()
  s = shop()?
  noSort = cepheus.Watch(2, (i, t) -> {Where: [[i, Invoice.Total, t]], Give: {I: i, T: t}, Limit: 2}, s.Db)
  after = cepheus.Watch(2, (i, t) -> {Where: [[i, Invoice.Total, t]], Give: {I: i, T: t}, Sort: [t], After: {I: 1, T: 10}}, s.Db)
  many = cepheus.Watch(2, (i, t) -> {Where: [[i, Invoice.Total, t]], Give: {I: i, T: t}, Sort: [t], Limit: 100001}, s.Db)
  sums = cepheus.Watch(2, (i, t) -> {Where: [[i, Invoice.Total, t]], Give: {N: cepheus.Count()}, Sort: [cepheus.Count()]}, s.Db)
  list.All([noSort.Error.Code == "invalid", after.Error.Code == "invalid", many.Error.Code == "invalid", sums.Error.Code == "invalid"])
end

defn isWatchSumsByDifference()
  s = shop()?
  w = cepheus.Watch(2, (i, t) -> {Where: [[i, Invoice.Status, "unpaid"], [i, Invoice.Total, t]], Give: {Unpaid: cepheus.Sum(t), N: cepheus.Count()}}, s.Db)?
  first = fiber.Receive(w.Changes)?
  cepheus.Insert(Invoice, {Client: s.Bo, Total: 19.5, Status: "unpaid"}, s.Db)?
  c = fiber.Receive(w.Changes)?
  cepheus.Close(w)
  value.Equal(first.Rows, [{Unpaid: 1280.5, N: 2}]) and value.Equal(c.Added, [{Unpaid: 1300.0, N: 3}]) and value.Equal(c.Removed, [{Unpaid: 1280.5, N: 2}])
end

defn isASlowWatcherGetsTheAnswerAgain()
  s = shop()?
  w = cepheus.Watch(1, (i) -> {Where: [[i, Invoice.Lines, 7]], Give: {Invoice: i}}, s.Db, size = 1)?
  first = fiber.Receive(w.Changes)?
  for k in 1..400
    cepheus.Insert(Invoice, {Client: s.Bo, Total: k, Status: "x", Lines: 7}, s.Db)?
  end
  again = fiber.Receive(w.Changes)?
  again = if value.IsMissing(again.Rows) fiber.Receive(w.Changes)? else again end
  cepheus.Close(w)
  value.Len(first.Rows) == 0 and value.Len(again.Rows) == 400
end

defn isWatchRefusesAMistake()
  s = shop()?
  bad = cepheus.Watch(1, (i) -> {Where: [[i, Invoice.Total, "lots"]], Give: {I: i}}, s.Db)
  bad.Error.Code == "invalid"
end

defn isWatchEndsWithUntil()
  (** A watch with until ends once that channel closes: its channel closes after the answer. *)
  s = shop()?
  until = fiber.Channel()
  w = cepheus.Watch(1, (i) -> {Where: [[i, Invoice.Status, "unpaid"]], Give: {Invoice: i}}, s.Db, until = until)?
  first = fiber.Receive(w.Changes)?
  fiber.Close(until)
  value.Len(first.Rows) == 2 and fiber.Receive(w.Changes, timeout = 2).Error.Kind == "closed"
end


Account = cepheus.Kind("account", {Late: cepheus.Bool(), Closed: cepheus.Bool()})
Bill = cepheus.Kind("bill", {Account: cepheus.Link(), Status: cepheus.Text(), Total: cepheus.Money(2)})

lateAccount = cepheus.Rule("late-account", 2, (a, b) -> {Where: [[b, Bill.Account, a], [b, Bill.Status, "late"]], Then: [a, Account.Late, true]})
noBillOfClosed = cepheus.Rule("no-bill-of-closed", 2, (a, b) -> {Where: [[b, Bill.Account, a], [a, Account.Closed, true]], Then: cepheus.Never})

defn isRuleDerivesAndRetracts()
  t = cepheus.Fork(cepheus.Empty, [Account, Bill])?
  cepheus.Define([lateAccount], t)?
  a = cepheus.Insert(Account, {Closed: false}, t)?
  b = cepheus.Insert(Bill, {Account: a, Status: "late", Total: 10}, t)?
  c = cepheus.Insert(Bill, {Account: a, Status: "late", Total: 20}, t)?
  late = cepheus.Get(Account, a, t)?.Late
  cepheus.Update(Bill, b, {Status: "paid"}, t)?
  still = cepheus.Get(Account, a, t)?.Late
  cepheus.Update(Bill, c, {Status: "paid"}, t)?
  late == true and still == true and cepheus.Get(Account, a, t)?.Late == missing
end

defn isRuleDerivesWhatIsThere()
  t = cepheus.Fork(cepheus.Empty, [Account, Bill])?
  a = cepheus.Insert(Account, {Closed: false}, t)?
  cepheus.Insert(Bill, {Account: a, Status: "late", Total: 10}, t)?
  cepheus.Define([lateAccount], t)?
  rows = cepheus.Find(1, (x) -> {Where: [[x, Account.Late, true]], Give: {Account: x}}, t)?
  value.Equal(rows, [{Account: a}])
end

defn isConstraintRefuses()
  t = cepheus.Fork(cepheus.Empty, [Account, Bill])?
  cepheus.Define([noBillOfClosed], t)?
  open = cepheus.Insert(Account, {Closed: false}, t)?
  shut = cepheus.Insert(Account, {Closed: true}, t)?
  cepheus.Insert(Bill, {Account: open, Status: "unpaid", Total: 5}, t)?
  refused = cepheus.Insert(Bill, {Account: shut, Status: "unpaid", Total: 5}, t)
  closing = cepheus.Update(Account, open, {Closed: true}, t)
  bug.Assert(refused.Error.Code == "invalid", "a bill of a closed account is refused")
  closing.Error.Code == "invalid" and cepheus.Get(Account, open, t)?.Closed == false
end

defn isDefineAgainWritesNothing()
  t = cepheus.Fork(cepheus.Empty, [Account, Bill])?
  cepheus.Define([lateAccount, noBillOfClosed], t)?
  before = cepheus.Update(Account, cepheus.Insert(Account, {Closed: false}, t)?, {Closed: false}, t)?
  cepheus.Define([noBillOfClosed, lateAccount], t)?
  after = cepheus.Insert(Account, {Closed: false}, t)
  cepheus.Update(Account, after?, {Closed: false}, t)? == before + 2
end

defn isRuleChanged()
  t = cepheus.Fork(cepheus.Empty, [Account, Bill])?
  cepheus.Define([lateAccount], t)?
  a = cepheus.Insert(Account, {Closed: false}, t)?
  cepheus.Insert(Bill, {Account: a, Status: "unpaid", Total: 10}, t)?
  unpaid = cepheus.Rule("late-account", 2, (a, b) -> {Where: [[b, Bill.Account, a], [b, Bill.Status, "unpaid"]], Then: [a, Account.Late, true]})
  cepheus.Define([unpaid], t)?
  cepheus.Get(Account, a, t)?.Late == true
end

defn isRuleRefusedWithItsReason()
  t = cepheus.Fork(cepheus.Empty, [Account, Bill])?
  loose = cepheus.Rule("loose", 3, (a, b, x) -> {Where: [[b, Bill.Account, a]], Then: [x, Account.Late, true]})
  inside = cepheus.Rule("inside", 2, (a, b) -> {Where: [[b, Bill.Account, a], cepheus.Or([b, Bill.Status, "paid"], [b, Bill.Status, "late"])], Then: [a, Account.Late, true]})
  named = cepheus.Rule("bill/Status", 2, (a, b) -> {Where: [[b, Bill.Account, a]], Then: [a, Account.Late, true]})
  value.Equal([cepheus.Define([loose], t).Error.Code, cepheus.Define([inside], t).Error.Code, cepheus.Define([named], t).Error.Code], ["invalid", "invalid", "invalid"])
end

Ledger = cepheus.Kind("ledger", {Name: cepheus.Text(), Bills: cepheus.Int(), Due: cepheus.Money(2), Smallest: cepheus.Money(2), Largest: cepheus.Money(2), Clean: cepheus.Bool()})

dueOf = cepheus.Rule("due-of", 3, (l, b, x) -> {Where: [[b, Bill.Account, l], [b, Bill.Total, x]], Then: [l, Ledger.Due, cepheus.Sum(x)]})
billsOf = cepheus.Rule("bills-of", 2, (l, b) -> {Where: [[b, Bill.Account, l]], Then: [l, Ledger.Bills, cepheus.Count()]})
smallestOf = cepheus.Rule("smallest-of", 3, (l, b, x) -> {Where: [[b, Bill.Account, l], [b, Bill.Total, x]], Then: [l, Ledger.Smallest, cepheus.Min(x)]})
largestOf = cepheus.Rule("largest-of", 3, (l, b, x) -> {Where: [[b, Bill.Account, l], [b, Bill.Total, x]], Then: [l, Ledger.Largest, cepheus.Max(x)]})
cleanLedger = cepheus.Rule("clean-ledger", 3, (l, n, b) -> {Where: [[l, Ledger.Bills, n], cepheus.Not([b, Bill.Account, l], [b, Bill.Status, "late"])], Then: [l, Ledger.Clean, true]})

defn isRuleWithNotAndAggregates()
  (** Sum, Count, Min, Max and Not kept up to date at every write, over three strata: the ledger is clean when it has
      bills and none of them is late. *)
  t = cepheus.Fork(cepheus.Empty, [Ledger, Bill])?
  cepheus.Define([dueOf, billsOf, smallestOf, largestOf, cleanLedger], t)?
  l = cepheus.Insert(Ledger, {Name: "a"}, t)?
  b1 = cepheus.Insert(Bill, {Account: l, Status: "paid", Total: 10}, t)?
  b2 = cepheus.Insert(Bill, {Account: l, Status: "late", Total: 25}, t)?
  first = cepheus.Get(Ledger, l, t)?
  bug.Assert(first.Bills == 2 and first.Due == 35 and first.Smallest == 10 and first.Largest == 25 and first.Clean == missing, "two bills, one late")
  cepheus.Update(Bill, b2, {Status: "paid"}, t)?
  cepheus.Update(Bill, b1, {Total: 4}, t)?
  g = cepheus.Get(Ledger, l, t)?
  g.Clean == true and g.Due == 29 and g.Smallest == 4 and g.Largest == 25
end

defn isRuleLeavesOutAnUnusedVariable()
  (** A rule's variable in no item of Where and Then is left out too. *)
  t = cepheus.Fork(cepheus.Empty, [Account, Bill])?
  late = cepheus.Rule("late-unused", 3, (a, b, spare) -> {Where: [[b, Bill.Account, a], [b, Bill.Status, "late"]], Then: [a, Account.Late, true]})
  cepheus.Define([late], t)?
  a = cepheus.Insert(Account, {Closed: false}, t)?
  cepheus.Insert(Bill, {Account: a, Status: "late", Total: 3}, t)?
  cepheus.Get(Account, a, t)?.Late == true
end

defn isAggregateYoursAlone()
  (** An aggregate's property is its rule's: a write of it is refused, and a rule over its own absence too. *)
  t = cepheus.Fork(cepheus.Empty, [Ledger, Bill, Account])?
  cepheus.Define([dueOf], t)?
  written = cepheus.Insert(Ledger, {Name: "b", Due: 3}, t)
  cyc = cepheus.Rule("cycle", 2, (a, b) -> {Where: [[b, Bill.Account, a], cepheus.Not([a, Account.Late, true])], Then: [a, Account.Late, true]})
  bounds = cepheus.Rule("bounds", 3, (a, b, x) -> {Where: [[b, Bill.Account, a], [b, Bill.Total, x], cepheus.Not([b, Bill.Status, "late"], cepheus.Above(x, 5))], Then: [a, Account.Late, true]})
  value.Equal([written.Error.Code, cepheus.Define([cyc], t).Error.Code, cepheus.Define([bounds], t).Error.Code], ["invalid", "invalid", "invalid"])
end

Scans = cepheus.Files("scan")

defn isAFileKindAKind()
  (** a file kind's facts are a kind's: written, read and asked as any; its bytes need a server *)
  t = cepheus.Fork(cepheus.Empty, [Scans])?
  id = cepheus.Insert(Scans, {Name: "a.pdf", Size: 3, Type: "application/pdf"}, t)?
  got = cepheus.Get(Scans, id, t)?
  listed = cepheus.List(Scans, t)?
  bug.Assert(got.Name == "a.pdf" and got.Size == 3 and got.Content == missing, "the facts of a file")
  bug.Assert(value.Equal(listed, [{Id: id, Name: "a.pdf", Size: 3, Type: "application/pdf"}]), "List is a Find")
  cepheus.Put(Scans, "b", "bytes", t).Error.Code == "invalid" and cepheus.Read(Scans, id, t).Error.Code == "invalid"
end
