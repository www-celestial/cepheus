(** Cepheus, a database of facts, from Cesia. A program connects to a database at a Cepheus server, declares its kinds,
    writes maps of their fields, reads them back, asks questions and writes groups of facts, all or nothing. On the
    server's machine its reads are served from its own memory, and still see every write confirmed before them. A fork
    is a database in the program's memory, for a test that needs no server. Errors are values: an Err of
    {Kind: "cepheus", Code, Message}. As everywhere in Cesia, the database comes last: db then cepheus.Get(Client, id). *)
use std/bug
use std/fiber
use std/result

(** A text property: a field of a kind. unique: no two things share a value; many: a list of values.

      Text().Type --> "text" *)
Text(unique = false, many = false) = {Type: "text", Unique: unique, Many: many}

(** A whole number of 63 bits. *)
Int(unique = false, many = false) = {Type: "int", Unique: unique, Many: many}

(** A 64-bit float. *)
Float(unique = false, many = false) = {Type: "float", Unique: unique, Many: many}

(** true or false. *)
Bool(unique = false, many = false) = {Type: "bool", Unique: unique, Many: many}

(** An instant, as the seconds since 1970 in UTC that sys.Now gives, kept to the millisecond: below 4.6e15 s either
    way, so that its milliseconds are an Int. *)
Date(unique = false, many = false) = {Type: "date", Unique: unique, Many: many}

(** Another thing of the database: its id. *)
Link(unique = false, many = false) = {Type: "link", Unique: unique, Many: many}

(** An exact decimal of scale digits after the point, as Money(2) for cents: read as a Float, kept in minor units. *)
Money(scale, unique = false, many = false) = {Type: "money", Scale: scale, Unique: unique, Many: many}

(** A kind of thing: its name, in small letters, and its fields, each a property of a type. It gives a map of its fields,
    each a property to name in a question (Client.City), and the field kind, which the package keeps for itself. The
    property of a field is the kind's name, a slash and the field's: client/City.

      Client = Kind("client", {Name: Text(), City: Text()}) *)
Kind(name, fields) = kind(name, fields)

(** A database at a Cepheus server, with these kinds declared in it (those it lacks are added, in one group): an Ok of
    the database, to give to every other function, or an Err. The address is cepheus://host:port/database; on the
    server's machine, where the server's Unix socket is in /run/cepheus, the connection goes through it and the reads
    are served here; elsewhere it is TLS to host:port, which needs ca, the certificate of the cluster's authority.
    ?socket=DIR names another folder of the Unix socket. token is the program's secret, made by cepheus token add. *)
Connect(url, kinds, token = missing, ca = missing) = connect(url, kinds, token, ca)

(** The map of a thing's fields of a kind: an Ok of it, missing for a field it has no value of, a list for a field of
    many values (empty when it has none); an Ok of missing when the thing has none of the kind's facts. *)
Get(kind, id, db) = get(db, kind, id)

(** A new thing with these fields, in one group: an Ok of its id. by is the id of who writes, why says why: both stay
    with the group in the history. *)
Insert(kind, fields, db, by = 0, why = "") = insert(db, kind, fields, by, why)

(** New values for these fields of a thing, in one group, each replacing the field's value: an Ok of the group's
    number. A field of many values changes with Write. *)
Update(kind, id, fields, db, by = 0, why = "") = update(db, kind, id, fields, by, why)

(** An operation of Write: the fact that thing has this value of a property, added. *)
Add(thing, property, value) = {Op: "add", Thing: thing, Property: property, Value: value}

(** An operation of Write: the fact removed. *)
Retract(thing, property, value) = {Op: "retract", Thing: thing, Property: property, Value: value}

(** An operation of Write: the whole group is refused, with Code "conflict", unless the thing has this value of the
    property before it; with value missing, unless it has none. *)
Expect(thing, property, value = missing) = {Op: "expect", Thing: thing, Property: property, Value: value}

(** An operation of Write: the thing's value of an Int property of one value (none counts 0) grows by by, read at
    this point of the group by the database, so that groups that count with one counter at once never conflict and
    never skip a value; a refused group leaves the counter as it was. into = [thing, property] also adds the new
    value there, an Int property: an invoice gets its number in the group that makes it. A value past the 63 bits
    refuses the group, Code "invalid".

      cepheus.Write([cepheus.Incr(counter, Counter.Last, into = [cepheus.New(1), Invoice.Number]),
                     cepheus.Add(cepheus.New(1), Invoice.Client, ada)], db) *)
Incr(thing, property, by = 1, into = missing) = {Op: "incr", Thing: thing, Property: property, Value: by, Into: into}

(** The thing that the group makes as its k-th new thing, in Add, Retract, Expect and Incr: New(1), New(2)... *)
New(k) = -k

(** A group of operations, all or nothing: an Ok of {Group, Things}, its number and the ids of its new things, New(1)
    first. A write over the network is answered once it is on the server's disk, and applied once even when the
    connection broke and the package sent it again. *)
Write(ops, db, by = 0, why = "") = write(db, ops, by, why)

(** An aggregate of Give: the sum of a variable, of the answers of a group. *)
Sum(x) = {Sum: x}

(** An aggregate of Give: the smallest value of a variable. *)
Min(x) = {Min: x}

(** An aggregate of Give: the largest value of a variable. *)
Max(x) = {Max: x}

(** An aggregate of Give: the number of answers of a group. *)
Count() = {Count: true}

(** A key of Sort, in descending order: the largest first. A key without it is ascending. *)
Desc(key) = {Desc: key}

(** A condition of Where: x above v, for an int, a float, a date or money. A bound between two milliseconds or two
    units of the money is rounded up, to the first value above it; Above the largest Int keeps nothing. Floats compare
    as Sort orders them (IEEE 754's totalOrder): -0 before 0, NaN after infinity. *)
Above(x, v) = {Range: x, Low: v, Open: "low"}

(** A condition of Where: x below v. A bound between two milliseconds or two units of the money is rounded down;
    Below the least Int keeps nothing. *)
Below(x, v) = {Range: x, High: v, Open: "high"}

(** A condition of Where: lo <= x <= hi, each bound rounded toward the inside when it falls between two
    milliseconds or two units of the money. *)
Between(x, lo, hi) = {Range: x, Low: lo, High: hi}

(** A condition of Where: x < y, two variables of one type (ints, floats, dates, money, texts by their bytes, links),
    each bound by a pattern; at the top of Where, in Not, or in an alternative of Or. *)
Less(x, y) = {Less: x, Than: y}

(** A condition of Where: x <= y, as Less. *)
LessOrEqual(x, y) = {Less: x, Than: y, Equal: true}

(** A part of Where that may have no fact: the pattern [thing, property, value] whose thing a pattern of Where binds
    and whose value is a variable in no other item. Each answer of the rest of Where comes once a value of the
    thing's property, or once with that variable missing (SQL's LEFT JOIN); a missing value sorts after every value,
    ascending and descending. At the top of Where only. *)
Optional(pattern) = {Optional: pattern}

(** A condition of Where: none of the facts these patterns name holds, with these conditions. Its variables in no
    other place of the question are its own: there is no value of them that makes every item hold. 1 to 4 patterns
    and conditions. *)
Not(a, b = missing, c = missing, d = missing) = {Not: [a, b, c, d]}

(** A condition of Where: at least one of these alternatives holds, each a pattern, a condition, or And of several.
    A variable in every alternative is the question's; one in some only is the alternative's own. 2 to 4. *)
Or(a, b, c = missing, d = missing) = {Or: [a, b, c, d]}

(** An alternative of Or that is several patterns and conditions, all holding. 1 to 4. *)
And(a, b = missing, c = missing, d = missing) = {And: [a, b, c, d]}

(** A condition of Where: x is one of these values, of its type (ids for a link). *)
In(x, values) = {In: x, Values: values}

(** A condition of Where: the text x starts with these bytes ("Ad" matches "Ada", not "ada"). *)
Prefix(x, text) = {Prefix: x, Text: text}

defn ask(n, question)
  (** The question called with n variables. *)
  v = variables(n)
  match n
    1 -> question(v[1])
    2 -> question(v[1], v[2])
    3 -> question(v[1], v[2], v[3])
    4 -> question(v[1], v[2], v[3], v[4])
    5 -> question(v[1], v[2], v[3], v[4], v[5])
    6 -> question(v[1], v[2], v[3], v[4], v[5], v[6])
    7 -> question(v[1], v[2], v[3], v[4], v[5], v[6], v[7])
    8 -> question(v[1], v[2], v[3], v[4], v[5], v[6], v[7], v[8])
    9 -> question(v[1], v[2], v[3], v[4], v[5], v[6], v[7], v[8], v[9])
    10 -> question(v[1], v[2], v[3], v[4], v[5], v[6], v[7], v[8], v[9], v[10])
    11 -> question(v[1], v[2], v[3], v[4], v[5], v[6], v[7], v[8], v[9], v[10], v[11])
    12 -> question(v[1], v[2], v[3], v[4], v[5], v[6], v[7], v[8], v[9], v[10], v[11], v[12])
    else -> bug.Panic("cepheus.Find: a question has 1 to 12 variables, not $n.")
  end
end

(** The answers of a question: an Ok of a list of maps, one an answer, with the fields of Give. The question is a
    function of n variables that gives {Where, Give}: Where a list of patterns [thing, property, value], each a fact
    that must hold, where any part but the property may be a variable, and of conditions (Above, Below, Between, In,
    Prefix, Less, LessOrEqual, Not, Or) and Optional patterns; Give
    a map of the variables, or of aggregates of them, to give. Each answer comes once. Optional: Sort, a list of
    fields of Give (a variable or an aggregate, Desc for the largest first), then the other fields by name; Limit, at
    most that many rows (and the copies of the last); After, the rows after a row of an earlier answer, in Sort's
    order: the next page. A variable in no item of Where and Give is left out, so a filter can be left out of Where
    without changing n. timeout: the seconds the question may take, past which it is an Err of Code "timeout"; at
    the server, the server's question_timeout is the most it takes (an admin token's may be longer).

      cepheus.Find(2, q, db, timeout = 2)? *)
Find(n, question, db, timeout = missing) = find(db, ask(n, question), n, timeout)

(** A rule of the database: a function of n variables that gives {Where, Then}, Where patterns [thing, property,
    value], Above, Below or Between, and Not (at most 16), and Then one pattern, the fact the rule gives for each answer
    of Where, or Never. The database keeps the facts its rules give up to date at every write, and a question reads
    them as any fact. Every variable of Then is in a pattern of Where outside Not.

      Rule("overdue", 2, (c, i) -> {Where: [[i, Invoice.Client, c], [i, Invoice.Status, "late"]], Then: [c, Client.Overdue, true]})

    The value of Then may be Sum(x), Min(x), Max(x) or Count(): the rule gives its thing one fact, the sum, the
    smallest, the largest value or the number of its answers (none without answers). That property takes one value,
    no write gives it, and no other rule. Sum is for ints and money, Min and Max for ints, dates and money:

      Rule("total-of", 3, (i, l, x) -> {Where: [[l, Line.Invoice, i], [l, Line.Price, x]], Then: [i, Invoice.Total, Sum(x)]})

    A rule set where a property depends on its own absence (Not) or its own aggregate is refused, naming the cycle. *)
Rule(name, n, rule) = {Rule: name, Vars: n, Body: ask(n, rule)}

(** The Then of a rule that is a constraint: a group that would give its Where an answer is refused whole, with
    Code "invalid" and the rule's name. *)
Never = "cepheus.Never"

(** Defines rules in a database, in one group: the new ones, and those whose definition changed, found by name; the
    others are left as they are, so a program defines its rules at each start. The group derives what the rules give
    over the whole database. An Ok of missing, or an Err with Code "invalid" for a rule the database refuses, as a
    variable of Then that no pattern binds. The rules of OWL 2 RL are defined the same way, as data that owl.Rl()
    gives (cesia/cepheus/owl): Define(list.Concat(owl.Rl(), [mine]), db). *)
Define(rules, db) = define(db, rules)

(** The class of a thing: the things that the rules made the same as it, itself included, by id, the smallest first
    (an Ok of a list); [thing] alone when none. OWL 2 RL's rules make things the same (owl.SameAs, a functional
    property: cesia/cepheus/owl). The facts of a class are kept on one of its things, and Get, Find and Watch read any
    thing of a class as that one: the facts of the whole class. *)
Same(thing, db) = same(db, thing)

(** A kind of files: each of its things is a file, with the fields Name (a Text), Size (an Int: its bytes), Type (a
    Text: a media type, as "application/pdf"), Owner (a Link: the thing whose key seals the bytes) and Content (the
    root of its bytes in the server's vault). Give it to Connect as any kind; the rights of a token on the kind are
    its rights on the files: to put one, a right to add to it; to read one, a right to read it.

      Scans = Files("scan") *)
Files(name) = kind(name, {Name: Text(), Size: Int(), Type: Text(), Owner: Link(), Content: Text()})

(** Stores a file: its bytes go to the server's vault, cut into chunks that are compressed, sealed with the key of
    owner (the database's own key when owner is 0), and stored once (a chunk the owner's files hold already is not
    stored again); then one group writes its facts: an Ok of its id, once its bytes and its facts are on the server's
    disk. cold = true for a file read seldom: smaller on the disk (Zstandard rather than LZ4), slower to store.

      f = cepheus.Put(Scans, "2026-11.pdf", sys.Read("2026-11.pdf")?, db, type = "application/pdf", owner = ada)? *)
Put(kind, name, content, db, type = "application/octet-stream", owner = 0, cold = false, by = 0, why = "") = put(db, kind, name, content, type, owner, cold, by, why)

(** The bytes of a file: an Ok of a Text of them, all of them, or len of them from the byte from. Only the chunks that
    hold the range are read; each is checked as it is read (a byte changed on the server's disk is an Err of Code
    "damaged", never a wrong byte).

      page = cepheus.Read(Scans, f, db, from = 10_000_000, len = 65_536)? *)
Read(kind, id, db, from = 0, len = missing) = read(db, kind, id, from, len)

(** The files of a kind: an Ok of a list of {Id, Name, Size, Type}. It is the question

      Find(4, (f, n, s, t) -> {Where: [[f, kind.Name, n], [f, kind.Size, s], [f, kind.Type, t]], Give: {Id: f, Name: n, Size: s, Type: t}}, db) *)
List(kind, db) = Find(4, (f, n, s, t) -> {Where: [[f, kind.Name, n], [f, kind.Size, s], [f, kind.Type, t]], Give: {Id: f, Name: n, Size: s, Type: t}}, db)

(** A file deleted: its facts retracted in one group (an Ok of its number); the group is refused, Code "conflict", if
    the file changed meanwhile. Its bytes stay in the vault as long as the history cites them; to make them unreadable
    everywhere, erase its owner's key. *)
Delete(kind, id, db, by = 0, why = "") = delete(db, kind, id, by, why)

(** The key of an owner destroyed: every file sealed with it can no longer be read, on this server's disk and in
    every copy of its bytes (replicas, backups), and no new file may name it as its owner. It cannot be undone. Needs a
    token that writes the whole database. An Ok of missing.

      cepheus.Erase(ada, db)? *)
Erase(owner, db) = erase(db, owner)

(** The empty database, to fork for a test. *)
Empty = "cepheus.Empty"

(** A database in this program's memory that starts as another (Empty, a fork, or a database read on the server's
    machine), with these kinds declared: an Ok of it. It reads and writes as a database, with the same checks, and
    nothing it writes goes anywhere: the database it started from doesn't change. *)
Fork(from, kinds = []) = fork(from, kinds)

defn feed(w, changes)
  (** Each message of a watch into its channel, until the watch ends. *)
  got = next(w)
  while result.IsOk(got)
    fiber.Send(got.Value, changes)
    got = next(w)
  end
  fiber.Close(changes)
end

defn Watch(n, question, db, size = 64, until = missing, timeout = missing)
  (** A live question: an Ok of {Changes, Watch}, Changes a channel of its messages, which holds size of them at most.
      The first is the answer, {Group, Rows}: the rows Find gives at group Group. Each next one is a change,
      {Group, Added, Removed}: the rows that came and the rows that went with group Group, so that the rows are then
      Find's at that group. A change comes only when the rows change, and only once its group is on the server's disk.
      When the connection breaks or the server restarts, the watch goes on by itself from its last group: no change
      is lost, none comes twice. A fiber that reads its channel too slowly gets the whole answer again, {Group, Rows},
      rather than every change it missed. Every fiber that watches the same question shares one watch at the server,
      and on the server's machine the changes are computed here, from the writes this program follows. The channel
      closes when the watch ends: Close(w), a token that may no longer read the database, or until, a channel, once it
      closes, as the s.Ended of a screen of std/live: live.Show("unpaid", cepheus.Watch(1, q, db, until = s.Ended)?.Changes).
      timeout: the seconds its first answer may take, as Find's. *)
  w = watch(db, ask(n, question), n, timeout)
  if result.IsErr(w)
    return w
  end
  changes = fiber.Channel(size = size)
  fiber.Spawn(() -> feed(w.Value, changes))
  watched = {Changes: changes, Watch: w.Value}
  if until != missing
    fiber.Spawn(() -> closing(until, watched))
  end
  result.Ok(watched)
end

defn closing(until, w)
  (** Closes a watch once the channel until closes; what is sent on it is not read for anything. *)
  while result.IsOk(fiber.Receive(until))
  end
  Close(w)
end

defn Close(x)
  (** Ends a connection, a watch, or forgets a fork. A watch's channel closes once its last message is taken. *)
  if close(x) == "watch"
    while result.IsOk(fiber.Receive(x.Changes, timeout = 0))
    end
  end
  missing
end
